<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ole_drag_drop</AssemblyName>
    <RootNamespace>OleDragDropTool</RootNamespace>
    <!-- Standalone automation tool: deliberately not part of any solution or the
         installer payload; built on demand with `dotnet build` from this folder. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
