# Server-only Vertex AI authentication. Never expose these values to the web app.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=D:/absolute/path/to/service-account-key.json
GOOGLE_GENAI_USE_VERTEXAI=true

# Model aliases are resolved by the API adapter capability registry.
VERTEX_TEXT_MODEL=gemini-3.5-flash
VERTEX_IMAGE_MODEL_NANO_BANANA_2=gemini-3.1-flash-image
VERTEX_IMAGE_MODEL_NANO_BANANA_PRO=gemini-3-pro-image-preview

# Required in production when API keys are managed from the provider settings UI.
# Development creates storage/.provider-credential-master-key on first save.
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MANGAFLOW_CREDENTIAL_MASTER_KEY=
# Keep false in production unless private-network provider endpoints are intentional.
ALLOW_PRIVATE_PROVIDER_NETWORKS=false

# Redis is optional for local AUTO/LOCAL queues. Docker Compose Redis requires
# AUTH; the default password is local-only and is not a production secret.
# Example with Compose: redis://:mangaflow-dev@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=mangaflow
QUEUE_ENABLED=true
JOB_TIMEOUT_SECONDS=900
MAX_AUTO_REPAIRS=3

# Optional local HTTP/Mixed proxy used by the Python API and Worker for Google services.
# Example for Clash Verge: http://127.0.0.1:7897
MANGAFLOW_PROXY_URL=

# Local development
DATABASE_URL=sqlite:///./storage/mangaflow.db
STORAGE_ROOT=./storage
UPLOAD_ROOT=./uploads
WEB_ORIGIN=http://127.0.0.1:3000
API_PORT=8000

# Docker Compose local data services (optional). Ports are loopback-only.
# POSTGRES_PASSWORD=mangaflow
# REDIS_PASSWORD=mangaflow-dev
