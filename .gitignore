# Local credentials and environment
.env
.env.*
!.env.example
*service-account*.json
*vertex*key*.json
gen-lang-client-*-key.json

# JavaScript
node_modules/
.next/
.next-dev/
out/
dist/
# Desktop shell build output is tracked for its committed placeholders
# (index.html so `cargo check` passes from a clean clone, shell-tools.html)
# and re-governed by apps/desktop/.gitignore.
!apps/desktop/dist/
coverage/
output/playwright/
# Only formal reports are tracked under output/; working artifacts stay local
output/rc-closure/
output/v02-21b-screens/
output/native-parity-review/
output/native-local/
output/desktop-installer/
# NUI-8 acceptance ledger tracks text/CSV/screenshot evidence only: offscreen render
# output is regenerable with `MangaFlow.Native.Tests.exe --render`, and the isolated
# run directories hold a real SQLite + media store that must not be committed.
output/nui8-release/render-*/
output/nui8-release/run-*/native-data/
output/nui8-release/run-*/web-data/
output/nui8-release/run-*/web-storage/
output/nui8-release/run-*/web-uploads/
output/nui8-release/run-*/downloads/*.zip
# NUI-9 render PNGs are regenerable with `MangaFlow.Native.Tests.exe --render`
output/nui9-rc/render-round*/
# NUI-9 sidecar live run dirs: isolated SQLite + media store, never committed
output/nui9-live*/
# NUI-6/7 side-by-side orchestrator run-dir (session state + evidence; formal report only is tracked)
output/nui67-acceptance/
# Local render-check artifacts + seeded SQLite store — never commit local SQLite files
testseed/
.playwright-mcp/
*.tsbuildinfo
npm-debug.log*
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Local runtime data
storage/*
!storage/.gitkeep
uploads/*
!uploads/.gitkeep
*.db
*.sqlite
*.sqlite3

# Editors / OS
.DS_Store
Thumbs.db
# Stray file created by PowerShell-style `> $null` redirects run under cmd
$null
# Crash dumps: 500 MB-scale, far past the 100 MB GitHub file limit — never commit
*.dmp
.idea/
.vscode/
.venv-poc/
.venv-desktop/
apps/desktop/src-tauri/web/
apps/desktop/dist/web-standalone/

# Repo-local portable build tools (NUI-8 P4: NSIS for the WPF client installer).
# Third-party binaries + their download archives are not source.
tools/nsis-*/
tools/*.zip
output/nui9-g2-*/
