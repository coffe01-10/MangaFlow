# Local credentials and environment
.env
.env.*
!.env.example
*service-account*.json
*vertex*key*.json
gen-lang-client-*-key.json

# JavaScript
node_modules/
.next/
.next-dev/
out/
dist/
# Desktop shell build output is tracked for its committed placeholders
# (index.html so `cargo check` passes from a clean clone, shell-tools.html)
# and re-governed by apps/desktop/.gitignore.
!apps/desktop/dist/
coverage/
output/playwright/
.playwright-mcp/
*.tsbuildinfo
npm-debug.log*
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Local runtime data
storage/*
!storage/.gitkeep
uploads/*
!uploads/.gitkeep
*.db
*.sqlite
*.sqlite3

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.venv-poc/
