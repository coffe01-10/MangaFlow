     use super::*;
 
+    /// `OwnershipError` is the operator-facing surface for every spawn /
+    /// assign / resume / stop failure: its Display strings land on stderr
+    /// and in logs, and `source()` must expose the underlying io::Error
+    /// ONLY for `Spawn` — the String variants carry their detail inline, so
+    /// a `source()` there would double-print it in any error chain.
+    /// Exact-substring pins keep the diagnostics from silently losing the
+    /// embedded detail in a refactor.
+    #[test]
+    fn ownership_error_display_embeds_each_detail_and_source_chains_spawn_only() {
+        let spawn = OwnershipError::Spawn(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            "helper binary missing",
+        ));
+        let rendered = spawn.to_string();
+        assert!(rendered.contains("spawn"), "prefix lost: {rendered}");
+        assert!(rendered.contains("helper binary missing"), "detail lost: {rendered}");
+        let source = std::error::Error::source(&spawn)
+            .expect("Spawn must chain its io::Error as source()");
+        assert_eq!(source.to_string(), "helper binary missing");
+
+        for (error, label) in [
+            (
+                OwnershipError::JobAssignment("assign detail".into()),
+                "Job Object 操作失败",
+            ),
+            (
+                OwnershipError::Resume("resume detail".into()),
+                "线程恢复流程失败",
+            ),
+            (
+                OwnershipError::StopFailed("stop detail".into()),
+                "停止进程树失败",
+            ),
+        ] {
+            let rendered = error.to_string();
+            assert!(rendered.contains(label), "label lost: {rendered}");
+            assert!(
+                rendered.contains("detail"),
+                "embedded detail lost: {rendered}"
+            );
+            assert!(
+                std::error::Error::source(&error).is_none(),
+                "String variants must not chain a source: {rendered}"
+            );
+        }
+    }
+
