+    /// Server thread with the RST-avoidance discipline of the caps fixture:
+    /// drain the request headers before writing, bounded tail drain before
+    /// close — closing with unread peer data queued sends RST and can sever
+    /// the client's in-flight read under parallel load.
+    fn respond_on_loopback(response: &'static [u8]) -> (String, std::thread::JoinHandle<()>) {
+        use std::io::{Read as _, Write as _};
+        use std::net::TcpListener;
+
+        let listener = TcpListener::bind("127.0.0.1:0").expect("bind loopback");
+        let port = listener.local_addr().unwrap().port();
+        let server = std::thread::spawn(move || {
+            let Ok((mut sock, _)) = listener.accept() else { return };
+            let _ = sock.set_read_timeout(Some(Duration::from_secs(2)));
+            let mut request = Vec::new();
+            let mut buffer = [0u8; 1024];
+            loop {
+                match sock.read(&mut buffer) {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => {
+                        request.extend_from_slice(&buffer[..n]);
+                        if request.windows(4).any(|window| window == b"\r\n\r\n") {
+                            break;
+                        }
+                    }
+                }
+                if request.len() > 16 * 1024 {
+                    break;
+                }
+            }
+            let _ = sock.write_all(response);
+            let _ = sock.flush();
+            let _ = sock.set_read_timeout(Some(Duration::from_millis(100)));
+            let _ = sock.read(&mut [0u8; 1024]);
+            let _ = sock.set_read_timeout(None);
+            let _ = sock.shutdown(std::net::Shutdown::Write);
+        });
+        (format!("http://127.0.0.1:{port}"), server)
+    }
+
+    /// The health surface's contract is pass-through: whatever status the
+    /// peer sends arrives as `Ok((status, body))`. The retry loop in
+    /// `wait_for_health` retries identically on `Err` and on non-200; the
+    /// callers that DO branch on the distinction are the tauri health probe
+    /// (`Err` renders as an error string, `Ok(status)` as a number) and the
+    /// shell simulator's body consumer. A `get_status` that started mapping
+    /// non-200 to `Err` — or that dropped the body — would silently change
+    /// what those callers report.
+    #[test]
+    fn get_status_passes_non_200_statuses_through_with_the_body() {
+        let (origin, server) = respond_on_loopback(
+            b"HTTP/1.0 404 Not Found\r\nContent-Type: application/json\r\n\r\n{\"detail\":\"not ready\"}",
+        );
+        let (status, body) =
+            get_status(&origin, HEALTH_PATH, Duration::from_secs(5)).expect("404 is not a transport error");
+        assert_eq!(status, 404);
+        assert!(body.contains("\"detail\":\"not ready\""), "body lost: {body}");
+        let _ = server.join();
+    }
+
+    /// A peer that accepts and closes WITHOUT any bytes yields an empty
+    /// response: the status-line parse must fail closed with InvalidData
+    /// ("bad status line"), never invent a status or return garbage.
+    #[test]
+    fn get_status_fails_closed_on_an_empty_response() {
+        let (origin, server) = respond_on_loopback(b"");
+        let error = get_status(&origin, HEALTH_PATH, Duration::from_secs(5))
+            .err()
+            .expect("an empty response must be an error");
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);
+        let _ = server.join();
+    }
+
+    /// With no listener at all, connect fails: the error must surface as
+    /// `Err` with ConnectionRefused — the caller's retry-vs-report decision
+    /// (and any diagnostics) depend on the refused case being an error, not
+    /// a fabricated status. The unbound ephemeral port is momentarily
+    /// re-bindable in theory; on loopback CI this is deterministic in
+    /// practice.
+    #[test]
+    fn get_status_maps_a_refused_connection_to_an_error() {
+        use std::net::TcpListener;
+
+        let listener = TcpListener::bind("127.0.0.1:0").expect("bind loopback");
+        let port = listener.local_addr().unwrap().port();
+        drop(listener);
+        let error = get_status(&format!("http://127.0.0.1:{port}"), HEALTH_PATH, Duration::from_secs(5))
+            .err()
+            .expect("a refused connection must be an error");
+        assert_eq!(error.kind(), std::io::ErrorKind::ConnectionRefused);
+    }
+
