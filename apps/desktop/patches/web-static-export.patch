+const API_URL =
+  typeof window !== "undefined" &&
+  (window as { __MANGAFLOW_API_ORIGIN__?: string }).__MANGAFLOW_API_ORIGIN__
+    ? `${(window as { __MANGAFLOW_API_ORIGIN__?: string }).__MANGAFLOW_API_ORIGIN__}/api/v1`
