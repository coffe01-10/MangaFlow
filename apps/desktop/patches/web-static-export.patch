@@ -0,0 +1,16 @@
+import type { ReactNode } from "react";
+
+// V02-53B disposable desktop-shell patch: the client settings page cannot
+// export route-segment config itself, so this passthrough layout supplies
+// the single "poc" stub combo required by `output: "export"` (dynamicParams
+// stays false; every real project id 404s in the exported form). Recorded
+// as D5 evidence for the desktop-shell PoC.
+export function generateStaticParams() {
+  return [{ id: "poc" }];
+}
+
+export const dynamicParams = false;
+
+export default function ProjectSettingsLayout({ children }: { children: ReactNode }) {
+  return children;
+}
