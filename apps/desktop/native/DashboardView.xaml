<UserControl x:Class="MangaFlow.Native.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="OnSizeChanged"
 Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
 FontFamily="Noto Sans SC, Microsoft YaHei UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="DashboardGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RailColumn" Width="308"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="DashboardMain" Margin="36,44,36,40">
    <Grid Margin="0,8,0,32">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="工作区 / 00" Style="{StaticResource SectionIndex}"/><TextBlock FontFamily="{StaticResource Serif}" FontSize="42" FontWeight="Bold" LineHeight="49" Margin="0,12,0,0"><Run Text="从文字开始，"/><LineBreak/><Run Text="把故事画出来。" Foreground="{StaticResource Accent}"/></TextBlock></StackPanel>
     <TextBlock Grid.Column="1" Text="面向连续漫画生产的结构化工作流。角色、服装、分镜与对白，每一步都可确认、可锁定、可修复。" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="24" VerticalAlignment="Bottom" Margin="28,0,0,4"/>
    </Grid>
    <Border BorderBrush="{StaticResource Ink}" BorderThickness="1" Background="{StaticResource Surface}">
     <Border.Effect><DropShadowEffect Color="#151512" BlurRadius="0" ShadowDepth="8" Direction="315" Opacity="0.08"/></Border.Effect>
     <Grid MinHeight="116"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource LineDark}" BorderThickness="0,0,1,0" Padding="16"><StackPanel><TextBlock Text="活跃项目" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ActiveProjectMetric}" Style="{StaticResource MetricValue}"/><TextBlock Text="PROJECTS" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="1" BorderBrush="{StaticResource LineDark}" BorderThickness="0,0,1,0" Padding="16"><StackPanel><TextBlock Text="漫画页面" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PageMetric}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding SelectedPageLabel}" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" BorderBrush="{StaticResource LineDark}" BorderThickness="0,0,1,0" Padding="16"><StackPanel><TextBlock Text="待复查" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ReviewMetric}" Style="{StaticResource MetricValue}"/><TextBlock Text="按页面去重" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="3" Background="{StaticResource Ink}" Padding="16"><StackPanel VerticalAlignment="Center"><TextBlock Text="AI 模型目录" Foreground="#AAA69D" FontSize="12"/><TextBlock Text="{Binding ModelLabel}" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,8"/><TextBlock Text="图片显式选择 · 文字可自动路由" Foreground="#AAA69D" FontSize="11"/></StackPanel></Border>
     </Grid>
    </Border>
    <Border Margin="0,42,0,20" Padding="0,0,0,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ProjectCount, StringFormat={}{0} 个项目}" Style="{StaticResource Caption}" VerticalAlignment="Bottom"/><StackPanel><TextBlock Text="项目 / PROJECTS" Style="{StaticResource SectionIndex}"/><TextBlock Text="最近创作" FontFamily="{StaticResource Serif}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></DockPanel>
    </Border>
    <!-- A bounded page keeps native visual creation predictable even for large libraries. -->
    <ItemsControl x:Name="ProjectCards" ItemsSource="{Binding DashboardProjects}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Tag="{Binding}" Click="OpenProject" Background="{StaticResource Surface}" Padding="10" Margin="0,0,16,20" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
       <StackPanel>
        <Border Height="270" BorderBrush="#C2BCAF" BorderThickness="1" Background="#D8D3C8" ClipToBounds="True">
         <Grid><Rectangle Fill="{StaticResource CoverPattern}" Opacity="0.5"/>
          <TextBlock Text="MANGA PROJECT" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
          <TextBlock Text="{Binding CoverTitle}" FontFamily="{StaticResource Serif}" FontSize="22" LineHeight="25" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,26,0,18"/>
          <Border BorderBrush="#8F2F1C" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="4" Margin="14"><Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform><TextBlock Text="制作中" FontFamily="{StaticResource Serif}" FontWeight="Bold" FontSize="12" Foreground="#8F2F1C"/></Border>
         </Grid>
        </Border>
        <DockPanel Margin="3,12,3,8"><TextBlock DockPanel.Dock="Right" Text="→" FontSize="18" Margin="8,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" FontFamily="{StaticResource Serif}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"><Run Text="{Binding ModeLabel}"/><Run Text=" · "/><Run Text="{Binding Resolution}"/></TextBlock></StackPanel></DockPanel>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="2" AutomationProperties.Name="采用进度"/>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="3,8,3,0"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="NewProjectCard" Click="CreateProject" Background="Transparent" BorderBrush="{StaticResource LineDark}" MinHeight="325" HorizontalAlignment="Left" IsEnabled="{Binding Connected}" Margin="0,0,16,0">
     <StackPanel HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="34" FontWeight="Normal" TextAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="建立新的漫画项目" FontFamily="{StaticResource Serif}" FontSize="17" TextAlignment="Center"/><TextBlock Text="设置项目，导入原作，开始创作" Style="{StaticResource Caption}" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel>
    </Button>
    <DockPanel Margin="0,20,16,0"><Button DockPanel.Dock="Left" Content="上一页" IsEnabled="{Binding HasPreviousPage}" Click="PreviousPage"/><Button DockPanel.Dock="Right" Content="下一页" IsEnabled="{Binding HasNextPage}" Click="NextPage"/><TextBlock Text="{Binding DashboardPageLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel>
   </StackPanel>
   <Border x:Name="DashboardRail" Grid.Column="1" Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="22,28">
    <StackPanel>
     <Border Style="{StaticResource Card}" BorderBrush="{StaticResource LineDark}" Padding="18"><StackPanel>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,14"><TextBlock Text="AI 连接 / CONNECTIONS" FontWeight="Bold" FontSize="12"/></Border>
      <TextBlock Text="{Binding AiConnectionTitle}" FontFamily="{StaticResource Serif}" FontSize="19" FontWeight="Bold" Margin="0,20,0,10"/>
      <TextBlock Text="模型与连接状态来自同一份目录，能力以验证结果为准。" Style="{StaticResource Caption}" LineHeight="21"/>
      <Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
       <TextBlock Text="已配置连接" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding ConfiguredConnections}" FontWeight="Bold"/>
       <TextBlock Grid.Row="1" Text="健康连接" Style="{StaticResource Caption}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HealthyConnections}" FontWeight="Bold"/>
       <TextBlock Grid.Row="2" Text="可用模型" Style="{StaticResource Caption}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EnabledModels}" FontWeight="Bold"/>
      </Grid>
      <Button Content="系统设置" Click="OpenSettings" BorderBrush="{StaticResource Ink}"/>
      <TextBlock Text="供应商编辑功能尚在迁移，当前可查看连接状态。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" BorderBrush="{StaticResource LineDark}" Padding="18" Margin="0,18,0,0"><StackPanel>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,14"><TextBlock Text="生产闭环" FontWeight="Bold" FontSize="13"/></Border>
      <ItemsControl Margin="0,12,0,8"><ItemsControl.Items>
       <TextBlock Text="01     导入原作" Margin="0,10" Foreground="{StaticResource AccentInk}"/>
       <TextBlock Text="02     建立资产" Margin="0,10"/>
       <TextBlock Text="03     剧本改编" Margin="0,10"/>
       <TextBlock Text="04     分页分镜" Margin="0,10"/>
       <TextBlock Text="05     生成页面" Margin="0,10"/>
       <TextBlock Text="06     人工校对与采用" Margin="0,10"/>
       <TextBlock Text="07     连续导出" Margin="0,10"/>
      </ItemsControl.Items></ItemsControl>
      <TextBlock Text="网页端完整生产流程。原生端目前已接入原作、章节与任务，其余环节逐步迁移。" Style="{StaticResource Caption}" LineHeight="21"/>
     </StackPanel></Border>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
