<Window x:Class="MangaFlow.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MangaFlow.Native"
 Title="MangaFlow · 原生工作台" Width="1320" Height="860" MinWidth="940" MinHeight="640"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown" SizeChanged="OnWindowSizeChanged">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="14,18,14,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="8,0,0,22"><TextBlock Text="漫画生产工作区" FontFamily="{StaticResource Serif}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PROJECT WORKSPACE" Style="{StaticResource SectionIndex}" Margin="0,30,0,0"/></Grid>
    <StackPanel Grid.Row="1">
     <Button Content="快速切换 · Ctrl+K" Style="{StaticResource Nav}" Click="OpenPalette"/>
     <Button Content="▦  项目概览" Style="{StaticResource Nav}" Click="ShowHome"/>
    </StackPanel>
    <ComboBox Grid.Row="2" x:Name="ProjectList" ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectionChanged="SelectProject" AutomationProperties.Name="切换项目" Margin="0,16,0,14"/>
    <ListBox Grid.Row="3" x:Name="ProjectSections" ItemsSource="{x:Static local:ProjectPages.All}" SelectionChanged="SelectProjectSection" AutomationProperties.Name="项目页面导航">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/><Setter Property="MinHeight" Value="48"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Index}" Style="{StaticResource SectionIndex}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4">
     <Separator Background="{StaticResource Line}" Margin="0,12"/>
     <Button Content="⚙  设置与连接" Style="{StaticResource Nav}" Click="ShowSettings"/>
     <Button Content="?  使用帮助" Style="{StaticResource Nav}" Click="ShowHelp"/>
     <TextBlock Text="本地创作 · 原生 Windows" Style="{StaticResource Caption}" Margin="12,16,0,4"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0" Background="{StaticResource Paper}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="SidebarToggle" Content="☰" BorderThickness="0" ToolTip="折叠侧栏 · Ctrl+B" Click="ToggleSidebar" AutomationProperties.Name="折叠侧栏"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="MANGAFLOW / PRODUCTION DESK" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="{Binding Breadcrumb}" FontFamily="{StaticResource Serif}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="HomeNav" Content="项目" Style="{StaticResource Nav}" Click="ShowHome"/>
      <Button x:Name="HelpNav" Content="帮助" Style="{StaticResource Nav}" Click="ShowHelp"/>
      <Button x:Name="SettingsNav" Content="设置" Style="{StaticResource Nav}" Click="ShowSettings"/>
      <Border x:Name="RuntimeBadge" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Margin="8,0" Padding="12,0"><TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Border>
      <Button Content="搜索" Click="OpenPalette" ToolTip="Ctrl+K" Margin="0,0,8,0"/>
      <Button Content="＋ 新建项目" Style="{StaticResource Primary}" Click="CreateProject" IsEnabled="{Binding Connected}"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" Background="#FFF3DF" Padding="20,12" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="重新连接" Click="Reconnect" Margin="16,0,0,0"/><TextBlock Text="{Binding Error}" VerticalAlignment="Center" Foreground="#94471A" AutomationProperties.LiveSetting="Polite"/></DockPanel>
   </Border>
   <Grid Grid.Row="2">
    <local:DashboardView x:Name="HomePage"/>
    <local:WorkspacePageFrame x:Name="ProjectPage" Page="{Binding Navigation.Current}" Visibility="Collapsed" Margin="28">
     <Grid>
     <Grid x:Name="SourcePane">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="10">
       <DockPanel><Button DockPanel.Dock="Top" Content="＋ 导入原作" Click="ImportSource" Margin="0,0,0,12" IsEnabled="{Binding Connected}"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ChapterHint}" Style="{StaticResource Caption}" Margin="6,10"/>
        <ListBox ItemsSource="{Binding Chapters}" SelectionChanged="ReadChapter" AutomationProperties.Name="章节列表"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
       <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding ReaderTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBox Text="{Binding ReaderText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="0" AutomationProperties.Name="章节原文"/>
       </DockPanel>
      </Border>
     </Grid>
     <Grid x:Name="JobsPane" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><ComboBox DockPanel.Dock="Right" x:Name="JobFilter" Width="130" SelectedIndex="0" SelectionChanged="FilterJobs" AutomationProperties.Name="筛选任务"><ComboBoxItem Content="全部任务"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="需要处理"/></ComboBox><TextBlock Text="{Binding JobHint}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding VisibleJobs}" AutomationProperties.Name="任务列表">
       <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentInk}" Margin="0,8,0,8"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Button Content="取消" Click="CancelJob" Tag="{Binding}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/><Button Content="重试…" Click="RetryJob" Tag="{Binding}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0"/></StackPanel>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <local:MigrationPage x:Name="PendingPage" DataContext="{Binding Navigation.Current}" Visibility="Collapsed"/>
     </Grid>
    </local:WorkspacePageFrame>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="36,32">
     <StackPanel MaxWidth="780" HorizontalAlignment="Left">
      <TextBlock Text="控制台 / SETTINGS" Style="{StaticResource SectionIndex}" Margin="0,0,0,10"/><TextBlock Text="系统设置" Style="{StaticResource Heading}"/><TextBlock Text="连接模型、配置运行参数，检查本地工作环境。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地服务" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionLabel}" Margin="0,12,0,8"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource Caption}"/><WrapPanel Margin="0,16,0,0"><Button Content="重新连接" Click="Reconnect" Margin="0,0,8,0"/><Button Content="打开数据文件夹" Click="OpenDataFolder" Margin="0,0,8,0"/><Button Content="导出诊断日志" Click="ExportLogs"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="运行偏好" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="修改只在保存后生效。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
       <TextBlock Text="默认并发任务数（1–8）"/><TextBox x:Name="ConcurrencyInput" MaxLength="1" Margin="0,8,0,16" AutomationProperties.Name="默认并发任务数"/>
       <TextBlock Text="任务超时（30–3600 秒）"/><TextBox x:Name="TimeoutInput" MaxLength="4" Margin="0,8,0,16" AutomationProperties.Name="任务超时"/>
       <TextBlock x:Name="SettingsMessage" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
       <Button Content="保存运行偏好" Style="{StaticResource Primary}" Click="SaveSettings" HorizontalAlignment="Left" IsEnabled="{Binding Connected}"/>
      </StackPanel></Border>
      <TextBlock Text="原生客户端正在逐步迁移完整创作功能。供应商配置、分镜画布与生成审阅目前仍使用已有工作台。" Style="{StaticResource Caption}" Margin="2,24"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="36,32"><StackPanel MaxWidth="700" HorizontalAlignment="Left">
     <TextBlock Text="留在创作里" Style="{StaticResource Heading}"/><TextBlock Text="原生窗口、键盘导航，以及清晰可控的后台工作。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="键盘快捷键" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Ctrl + K     搜索并切换项目&#10;&#10;Ctrl + N     新建项目&#10;&#10;Ctrl + B     折叠 / 展开侧栏&#10;&#10;F5                刷新当前页面&#10;&#10;Esc              关闭对话框" Margin="0,18,0,0"/></StackPanel></Border>
     <TextBlock Text="开始创作" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="新建项目后，导入 TXT / Markdown 或粘贴正文。点击章节即可阅读，任务中心显示后台执行进度与失败原因。"/>
     <TextBlock Text="关于本机数据" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="关窗会停止本次客户端启动的本地服务。运行中的任务可能中断，请先在任务中心确认状态。已有数据不会因关闭窗口而删除。"/>
     <TextBlock Text="迁移中的功能" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="这个版本已接通项目、原作、章节、任务与运行设置。资产编辑、分镜画布、导演、生成审阅和供应商配置尚未迁移到原生界面。旧工作台保留这些功能。"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,5"><DockPanel><TextBlock Text="WPF · 本地工作台" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
   <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
  </Grid>
 </Grid>
</Window>
