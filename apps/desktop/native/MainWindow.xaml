<Window x:Class="MangaFlow.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MangaFlow.Native"
 xmlns:views="clr-namespace:MangaFlow.Native.Views"
 xmlns:c="clr-namespace:MangaFlow.Native.Controls"
 Title="MangaFlow · 原生工作台" Width="1320" Height="860" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown" SizeChanged="OnWindowSizeChanged">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition x:Name="TopbarRow" Height="74"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="0"/>
  </Grid.RowDefinitions>

  <!-- Top bar -->
  <Border Grid.Row="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="34,0">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="SidebarToggle" Content="☰" BorderThickness="0" MinWidth="36" ToolTip="折叠侧栏 · Ctrl+B" Click="ToggleSidebar" AutomationProperties.Name="折叠侧栏"/>
     <Button x:Name="BackToProjects" Content="← 项目" Style="{StaticResource Nav}" Click="ShowHome" Margin="0,0,16,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="BrandKicker" Text="MANGAFLOW / PRODUCTION DESK" Style="{StaticResource Kicker}" Margin="0,0,0,4"/>
      <TextBlock x:Name="TopTitle" Text="漫画生产台" FontFamily="{StaticResource Serif}" FontSize="17" FontWeight="Bold"/>
     </StackPanel>
    </StackPanel>
    <TextBlock Grid.Column="1" x:Name="Breadcrumb" Text="{Binding Breadcrumb}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel x:Name="GlobalActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="HomeNav" Content="项目" Style="{StaticResource Nav}" Click="ShowHome"/>
     <Button x:Name="UsageNav" Content="用量" Style="{StaticResource Nav}" Click="ShowUsage" Visibility="Collapsed"/>
     <Button x:Name="HelpNav" Content="帮助" Style="{StaticResource Nav}" Click="ShowHelp"/>
     <Button x:Name="SettingsNav" Content="设置" Style="{StaticResource Nav}" Click="ShowSettings"/>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Margin="8,0" Padding="12,0">
      <TextBlock Text="{Binding ConnectionBadgeLabel}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
     </Border>
     <Button Content="系统设置" Style="{StaticResource Ghost}" Click="ShowSettings" Margin="0,0,12,0"/>
     <Button Content="＋ 新建项目" Style="{StaticResource InkButton}" Click="CreateProject" IsEnabled="{Binding Connected}"/>
    </StackPanel>
    <StackPanel x:Name="WorkspaceActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
     <TextBlock Text="● 项目工作区" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <Button Content="在工作流中查看" Style="{StaticResource Outline}" Click="ShowWorkflow" Margin="0,0,12,0"/>
     <Button Content="项目设置" Style="{StaticResource InkButton}" Click="ShowProjectSettings"/>
    </StackPanel>
    <StackPanel x:Name="SettingsActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
     <Button Content="用量与成本看板" Style="{StaticResource Ghost}" Click="ShowUsage" Margin="0,0,12,0"/>
     <Button Content="← 返回项目" Style="{StaticResource Ghost}" Click="ShowHome" Margin="0,0,12,0"/>
     <Button Content="保存运行设置" Style="{StaticResource InkButton}" Click="SaveRuntimeSettings" IsEnabled="{Binding Connected}"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Error strip -->
  <Border Grid.Row="1" VerticalAlignment="Top" Background="#FFF3DF" Padding="20,10" Panel.ZIndex="20"
   Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="重新连接" Click="Reconnect" Margin="16,0,0,0"/>
    <TextBlock Text="{Binding Error}" VerticalAlignment="Center" Foreground="#94471A" TextWrapping="Wrap"/>
   </DockPanel>
  </Border>

  <!-- Workspace: sidebar + content -->
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True">
    <Grid Margin="8,24,8,12">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel x:Name="ProjectSummary" Margin="12,0,12,16">
      <TextBlock Text="PROJECT / 01" Style="{StaticResource Kicker}"/>
      <TextBlock Text="{Binding CurrentProject.Name}" Style="{StaticResource SubHeading}" Margin="0,8,0,8"/>
      <TextBlock Text="{Binding CurrentProject.Summary}" Style="{StaticResource Caption}"/>
     </StackPanel>
     <ComboBox Grid.Row="1" x:Name="ProjectList" ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
      SelectionChanged="SelectProject" AutomationProperties.Name="切换项目" Margin="0,0,0,12"/>
     <ListBox Grid.Row="2" x:Name="ProjectSections" ItemsSource="{x:Static local:ProjectPages.All}"
      SelectionChanged="SelectProjectSection" AutomationProperties.Name="项目页面导航" Margin="0,0,0,12">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="ToolTip" Value="{Binding Title}"/>
        <Setter Property="Padding" Value="8,10"/>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Index}" Style="{StaticResource SectionIndex}" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1">
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
           <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
         </StackPanel>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="SidebarFooter" Grid.Row="4">
      <Separator Background="{StaticResource Line}" Margin="0,8"/>
      <Button Content="搜索与切换 · Ctrl+K" Style="{StaticResource Nav}" Click="OpenPalette"/>
     </StackPanel>
    </Grid>
   </Border>
   <c:TransitioningContentControl x:Name="ContentHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True"/>
  </Grid>

  <!-- Queue dock (web .queue-dock): ink bar, status dot, counts, latest-job actions -->
  <Border x:Name="QueueDock" Grid.Row="2" Height="48" Background="{StaticResource Ink}" Padding="20,0,64,0"
    Visibility="{Binding DockShown, Converter={StaticResource BoolVisibility}}" Cursor="Hand" MouseLeftButtonDown="OpenJobs"
    AutomationProperties.Name="打开任务中心">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="DockCancel" Content="取消" Click="DockCancelJob" Visibility="{Binding DockCancelShown, Converter={StaticResource BoolVisibility}}"
       Background="Transparent" Foreground="#FCFBF7" BorderBrush="#4B4942" MinHeight="30" MinWidth="56" Padding="12,0" FontSize="12" FontWeight="Bold"
       ToolTip="取消最新任务" AutomationProperties.Name="取消最新任务"/>
     <Button x:Name="DockRetry" Content="重试" Click="DockRetryJob" Visibility="{Binding DockRetryShown, Converter={StaticResource BoolVisibility}}"
       Background="Transparent" Foreground="#FCFBF7" BorderBrush="#4B4942" MinHeight="30" MinWidth="56" Padding="12,0" Margin="8,0,0,0" FontSize="12" FontWeight="Bold"
       ToolTip="重新排队最新失败任务（可能产生费用）" AutomationProperties.Name="重试最新任务"/>
     <Button x:Name="DockToggle" Content="▾" Click="HideDock" MinWidth="40" MinHeight="34" Margin="12,0,0,0"
       Background="Transparent" Foreground="#FCFBF7" BorderBrush="#4B4942" FontSize="13"
       ToolTip="隐藏任务中心快捷栏" AutomationProperties.Name="隐藏任务中心快捷栏"/>
    </StackPanel>
    <Grid VerticalAlignment="Center">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="1*"/>
     </Grid.ColumnDefinitions>
     <Ellipse Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center">
      <Ellipse.Style>
       <Style TargetType="Ellipse">
        <Setter Property="Fill" Value="#716E67"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding DockWaiting}" Value="True">
          <Setter Property="Fill" Value="{StaticResource Warning}"/>
          <Setter Property="Effect">
           <Setter.Value><DropShadowEffect Color="#B77C26" BlurRadius="9" ShadowDepth="0" Opacity="0.55"/></Setter.Value>
          </Setter>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Ellipse.Style>
     </Ellipse>
     <TextBlock Grid.Column="1" Text="打开任务中心" Foreground="#FCFBF7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="{Binding DockStatusText}" Foreground="#9A978F" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="3" Text="{Binding DockNotice}" Foreground="#E4B664" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
      Visibility="{Binding DockNoticeShown, Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Grid.Column="4" Text="{Binding DockSummary}" Foreground="#9A978F" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
      Visibility="{Binding DockCountShown, Converter={StaticResource BoolVisibility}}"/>
    </Grid>
   </DockPanel>
  </Border>
  <Border Grid.Row="2" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"
   Visibility="{Binding DockRestoreShown, Converter={StaticResource BoolVisibility}}">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="DockRestore" Content="▴ 任务" Click="ShowDock" MinWidth="76" MinHeight="38" Padding="0"
      Background="#25241F" Foreground="#FCFBF7" BorderBrush="#4B4942" FontSize="12"
      ToolTip="显示任务中心快捷栏" AutomationProperties.Name="显示任务中心快捷栏"/>
    <Ellipse Width="6" Height="6" Fill="{StaticResource Warning}" Margin="-22,0,0,24"
     Visibility="{Binding DockWaiting, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/>
   </StackPanel>
  </Border>

  <!-- Status bar -->
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,4">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="WPF · 本地工作台" Style="{StaticResource Micro}"/>
    <TextBlock Text="{Binding Status}" Style="{StaticResource Micro}"/>
   </DockPanel>
  </Border>
  <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True"
   Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
 </Grid>
</Window>
