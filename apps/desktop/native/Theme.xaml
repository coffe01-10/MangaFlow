<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MangaFlow.Native"
 xmlns:c="clr-namespace:MangaFlow.Native.Controls">
 <!-- Design tokens mirrored from apps/web/app/globals.css :root. Keep in sync. -->
 <Color x:Key="InkColor">#151512</Color>
 <Color x:Key="InkSoftColor">#32312C</Color>
 <Color x:Key="PaperColor">#F4F1E9</Color>
 <Color x:Key="PaperDeepColor">#EBE6DA</Color>
 <Color x:Key="WhiteColor">#FCFBF7</Color>
 <Color x:Key="LineColor">#D7D1C4</Color>
 <Color x:Key="LineDarkColor">#AAA396</Color>
 <Color x:Key="VermillionColor">#D34A2F</Color>
 <Color x:Key="VermillionInkColor">#A63D24</Color>
 <Color x:Key="GreenColor">#47745A</Color>
 <Color x:Key="AmberColor">#B77C26</Color>
 <Color x:Key="DangerColor">#B23C25</Color>
 <Color x:Key="MutedColor">#66604F</Color>
 <Color x:Key="SuccessBgColor">#EDF3E9</Color>
 <Color x:Key="WarningBgColor">#FFF3DF</Color>
 <Color x:Key="DangerBgColor">#F8EAE6</Color>

 <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
 <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}"/>
 <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
 <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}"/>
 <SolidColorBrush x:Key="PaperDeep" Color="{StaticResource PaperDeepColor}"/>
 <SolidColorBrush x:Key="Surface" Color="{StaticResource WhiteColor}"/>
 <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
 <SolidColorBrush x:Key="LineDark" Color="{StaticResource LineDarkColor}"/>
 <SolidColorBrush x:Key="Accent" Color="{StaticResource VermillionColor}"/>
 <SolidColorBrush x:Key="AccentInk" Color="{StaticResource VermillionInkColor}"/>
 <SolidColorBrush x:Key="AccentSoft" Color="#22D34A2F"/>
 <SolidColorBrush x:Key="Selected" Color="#E9DFD0"/>
 <SolidColorBrush x:Key="Success" Color="{StaticResource GreenColor}"/>
 <SolidColorBrush x:Key="SuccessBg" Color="{StaticResource SuccessBgColor}"/>
 <SolidColorBrush x:Key="Warning" Color="{StaticResource AmberColor}"/>
 <SolidColorBrush x:Key="WarningBg" Color="{StaticResource WarningBgColor}"/>
 <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
 <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}"/>

 <FontFamily x:Key="Serif">Noto Serif SC, Songti SC, STSong, SimSun</FontFamily>
 <FontFamily x:Key="Mono">Consolas, Courier New</FontFamily>

 <!-- Timing tokens: web duration fast 120ms / base 180ms, ease-out cubic bezier (.2,.75,.2,1). -->
 <Duration x:Key="Fast">0:0:0.12</Duration>
 <Duration x:Key="Base">0:0:0.18</Duration>
 <Duration x:Key="Slow">0:0:0.28</Duration>
 <c:EaseOutQuint x:Key="EaseOut"/>

 <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
 <local:InvertBoolConverter x:Key="InvertBool"/>
 <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
 <local:EmptyToVisibilityConverter x:Key="EmptyToCollapsed"/>
 <c:ProgressToPercentConverter x:Key="Percent"/>

 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="Microsoft YaHei UI, Noto Sans SC"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Background" Value="{StaticResource Paper}"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>

 <!-- Kicker: 9px letterspaced caption above section titles. -->
 <Style x:Key="Kicker" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="ExtraBold"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="Micro" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="SectionIndex" TargetType="TextBlock" BasedOn="{StaticResource Kicker}">
  <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
 </Style>
 <Style x:Key="Heading" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
  <Setter Property="FontSize" Value="24"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,0,0,10"/>
 </Style>
 <Style x:Key="SubHeading" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
  <Setter Property="FontSize" Value="17"/>
  <Setter Property="FontWeight" Value="Bold"/>
 </Style>
 <Style x:Key="MetricValue" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
  <Setter Property="FontSize" Value="32"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Margin" Value="0,3"/>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="#5E5A52"/>
  <Setter Property="Margin" Value="0,0,0,6"/>
 </Style>

 <!-- ============ Buttons: paper language, hard shadows, 120ms hover lift ============ -->
 <Style TargetType="Button">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="18,0"/>
  <Setter Property="MinHeight" Value="42"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="c:HoverMotion.Enabled" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid>
      <Border Background="{TemplateBinding BorderBrush}" Margin="3,3,-3,-3" Opacity="0.06" CornerRadius="3" IsHitTestVisible="False"/>
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="4" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="InkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{StaticResource Ink}"/>
  <Setter Property="Foreground" Value="White"/>
  <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
 </Style>

 <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
 </Style>
 <Style x:Key="Outline" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
 </Style>
 <Style x:Key="Compact" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
 <Style x:Key="CompactInk" TargetType="Button" BasedOn="{StaticResource InkButton}">
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
 <!-- 兼容别名：EditorDialog 引用 "Primary" 键 -->
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource InkButton}"/>
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Foreground" Value="{StaticResource Danger}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
 </Style>
 <Style x:Key="CompactDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}">
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="Padding" Value="12,0"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Ghost}">
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Margin" Value="0,1"/>
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Selected}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Rectangular toggle; legacy key retained for existing callers. -->
 <Style x:Key="Pill" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Surface" Property="Background" Value="{StaticResource Ink}"/>
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/>
       <Setter Property="Foreground" Value="White"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
       <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Vermillion-accented chip (director scopes / active filters). -->
 <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="1" CornerRadius="0" Padding="12,0">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="12"
       TextElement.FontWeight="Bold"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
       <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoft}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentInk}"/>
       <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="AssetTab" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Padding" Value="15,0"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Grid>
      <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,3">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PaperDeep}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ModelChoice" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
  <Setter Property="MinHeight" Value="68"/>
  <Setter Property="Padding" Value="12"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Grid>
      <Border x:Name="Shadow" Background="{StaticResource Ink}" Opacity="0.09" Margin="4,4,-4,-4" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="Surface" Background="#66FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
        <TextBlock Text="✦" FontSize="18" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
        <TextBlock x:Name="Check" Grid.Column="2" Text="✓" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource Surface}"/><Setter TargetName="Shadow" Property="Visibility" Value="Visible"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Surface" Background="Transparent" BorderBrush="{StaticResource LineDark}" BorderThickness="1"
      CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Surface" Property="Background" Value="{StaticResource Ink}"/>
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/>
       <Setter Property="Foreground" Value="White"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- ============ Inputs ============ -->
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="12,10"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="SelectionBrush" Value="#E4B4A6"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
  <Setter Property="FontSize" Value="14"/>
  <Style.Triggers>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter Property="Opacity" Value="0.6"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="DatePicker">
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Language" Value="zh-CN"/>
  <Setter Property="SelectedDateFormat" Value="Short"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CalendarStyle">
   <Setter.Value>
    <Style TargetType="Calendar">
     <Setter Property="Background" Value="{StaticResource Surface}"/>
     <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
     <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
   </Setter.Value>
  </Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DatePicker">
     <Grid>
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
        <DatePickerTextBox x:Name="PART_TextBox" Padding="8,6,0,6" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}">
         <DatePickerTextBox.Template>
          <ControlTemplate TargetType="DatePickerTextBox">
           <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            <ContentControl x:Name="PART_Watermark" Visibility="Collapsed" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" Focusable="False"/>
           </Grid>
           <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
         </DatePickerTextBox.Template>
        </DatePickerTextBox>
        <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" AutomationProperties.Name="打开日历" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
         <Button.Template>
          <ControlTemplate TargetType="Button">
           <Border x:Name="CalendarButton" Background="{TemplateBinding Background}">
            <Path Width="14" Height="15" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2" Data="M 1,3 L 13,3 13,14 1,14 Z M 1,6 L 13,6 M 4,1 L 4,4 M 10,1 L 10,4 M 4,9 L 6,9 M 8,9 L 10,9 M 4,11 L 6,11"/>
           </Border>
           <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CalendarButton" Property="Background" Value="{StaticResource PaperDeep}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
         </Button.Template>
        </Button>
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Frame}" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None"/>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Padding" Value="12,10"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineDark}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border x:Name="Frame" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineDark}" BorderThickness="1" CornerRadius="3">
          <Path Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
         </Border>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,6,32,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="4,2,28,2" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
       <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineDark}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0" Padding="4">
        <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ComboBoxItem">
     <Setter Property="Padding" Value="12,8"/>
     <Setter Property="FontSize" Value="13"/>
     <Setter Property="SnapsToDevicePixels" Value="True"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="0">
         <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Surface" Property="Background" Value="{StaticResource Selected}"/>
         </Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Surface" Property="Background" Value="{StaticResource Selected}"/>
          <Setter Property="FontWeight" Value="Bold"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <StackPanel Orientation="Horizontal" Background="Transparent">
      <Border x:Name="Box" Width="20" Height="20" BorderBrush="{StaticResource LineDark}" BorderThickness="1"
       Background="#84FCFBF7" CornerRadius="3" VerticalAlignment="Center">
       <Path x:Name="Check" Data="M 3,8 L 7.5,12.5 L 15,3" Stroke="White" StrokeThickness="2.4"
        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource Ink}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}"/>
       <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Switch (role=switch): workflow mode toggles in project settings. -->
 <Style x:Key="Switch" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <StackPanel Orientation="Horizontal" Background="Transparent">
      <Grid Width="44" Height="24" VerticalAlignment="Center">
       <Border x:Name="Track" Background="{StaticResource Line}" CornerRadius="3"/>
       <Border x:Name="Knob" Width="20" Height="20" CornerRadius="2" Background="{StaticResource Surface}"
        HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
       </Border>
      </Grid>
      <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Track" Property="Background" Value="{StaticResource Ink}"/>
       <Trigger.EnterActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="{StaticResource Base}" EasingFunction="{StaticResource EaseOut}"/>
         </Storyboard>
        </BeginStoryboard>
       </Trigger.EnterActions>
       <Trigger.ExitActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource Base}" EasingFunction="{StaticResource EaseOut}"/>
         </Storyboard>
        </BeginStoryboard>
       </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

