<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SettingsModeChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#151512"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#d7d1c5"/><Setter Property="Padding" Value="12,10"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Border x:Name="Frame" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
          <Grid>
            <Border x:Name="Accent" Width="3" Background="#d34a2f" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
              <ContentPresenter Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Path x:Name="Check" Grid.Column="1" Data="M1 7L5 11 13 2" Stroke="#151512" StrokeThickness="1.5" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="#151512"/><Setter TargetName="Frame" Property="Background" Value="#fcfbf7"/>
            <Setter TargetName="Accent" Property="Visibility" Value="Visible"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#151512"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#d34a2f"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsContinuitySwitch" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="64"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="Frame" Background="Transparent" BorderBrush="#d7d1c5" BorderThickness="0,0,0,1" Padding="0,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions>
            <ContentPresenter Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Border x:Name="Track" Grid.Column="1" Width="35" Height="19" Background="#ddd7cb" BorderBrush="#aaa396" BorderThickness="1" Padding="2">
              <Border x:Name="Thumb" Width="13" Background="#66604f" HorizontalAlignment="Left"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="#e1e9e0"/><Setter TargetName="Track" Property="BorderBrush" Value="#47745a"/>
            <Setter TargetName="Thumb" Property="Background" Value="#47745a"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#d34a2f"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
