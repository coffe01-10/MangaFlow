<UserControl x:Class="MangaFlow.Native.MigrationPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <Border Style="{StaticResource Card}" BorderBrush="{StaticResource LineDark}">
    <StackPanel>
     <TextBlock Text="此页面正在迁移到原生工作台" FontFamily="{StaticResource Serif}" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="页面入口已准备好，以下功能尚未接通。当前请继续在已有网页工作台使用这些功能。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="页面功能" Style="{StaticResource SectionIndex}" Margin="0,26,0,12"/>
   <ItemsControl ItemsSource="{Binding Areas}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="1" Text="待接通" Style="{StaticResource Caption}" Margin="20,0,0,0"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
 </ScrollViewer>
</UserControl>
