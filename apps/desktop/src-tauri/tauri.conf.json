{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaFlow",
  "version": "0.2.0",
  "identifier": "com.mangaflow.desktop",
  "build": {
    "frontendDist": "../dist/frontend",
    "beforeBuildCommand": {
      "script": "node scripts/guard-frontend-dist.mjs",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "web/node/node.exe": "web/node/node.exe",
      "web/standalone/": "web/standalone/"
    }
  }
}
