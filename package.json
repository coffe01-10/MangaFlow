{
  "name": "mangaflow-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:full": "concurrently -n web,api,worker -c cyan,magenta,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:web": "npm run dev --workspace @mangaflow/web",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --app-dir apps/api --host 127.0.0.1 --port 8000",
    "dev:worker": ".venv\\Scripts\\python.exe apps/api/run_worker.py",
    "build": "npm run build --workspace @mangaflow/web",
    "lint": "npm run lint --workspace @mangaflow/web && .venv\\Scripts\\python.exe -m ruff check apps/api tests",
    "test": ".venv\\Scripts\\python.exe -m pytest",
    "test:web": "npm run test --workspace @mangaflow/web",
    "serve:e2e:web": "npm run start --workspace @mangaflow/web -- --hostname 127.0.0.1",
    "serve:e2e:api": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000",
    "test:e2e": ".venv\\Scripts\\python.exe scripts/run_e2e_owned.py playwright",
    "check": "npm run lint && npm run test && npm run test:web && npm run build",
    "check:full": ".venv\\Scripts\\python.exe scripts/run_e2e_owned.py full",
    "test:phase2-performance": ".venv\\Scripts\\python.exe scripts/run_e2e_owned.py performance"
  },
  "devDependencies": {
    "concurrently": "10.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
